# Copiar como .env en el VPS y rellenar. NO versionar el .env real.

# Imagen inmutable construida con infra/frappe/apps.json y publicada en un
# registro accesible por el VPS (Docker Hub, GHCR, etc.).
CRM_IMAGE=docker.io/jarinox/frappe-crm:v15-pilot-20260809

# Dominio público del piloto (debe resolver a la IP del VPS).
SITE_NAME=crm.ejemplo.com

# Correo para los avisos de expiración de Let's Encrypt.
LETSENCRYPT_EMAIL=ops@ejemplo.com

# Versión de MariaDB. Frappe v15 no prueba versiones > 10.8 (decisión D-005).
DB_IMAGE_TAG=10.8

# Contraseña root de MariaDB. Generar con: openssl rand -base64 32
DB_ROOT_PASSWORD=

# Contraseña del usuario Administrator del sitio Frappe (solo para crearlo).
ADMIN_PASSWORD=

# Ajuste de gunicorn según los núcleos del VPS: (2 x núcleos) + 1
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
